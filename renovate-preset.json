{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Opt-in strict pins; review every update. No bot installation is implied.",
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "rangeStrategy": "pin",
  "ignoreUnstable": true,
  "enabledManagers": ["github-actions", "dockerfile", "docker-compose", "npm", "pip-compile", "custom.regex"],
  "ignorePaths": ["**/node_modules/**", "tools/renovate/fixtures/**", "docs/adr/**", "docs/issues/**"],
  "pip-compile": {"managerFilePatterns": ["/requirements\\.lock$/"]},
  "packageRules": [
    {
      "description": "One reviewed guidance release across opted-in documentation, Task variables and workflow calls.",
      "matchPackageNames": ["Living-Proof-Labs/collaboration-guidelines"],
      "groupName": "collaboration guidelines",
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+$/",
      "separateMajorMinor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^AGENTS\\.md$/", "/^README\\.md$/", "/^docs\\/dependency-pins\\.md$/"],
      "matchStrings": ["(?<prefix><!-- renovate: guidelines -->\\r?\\n\\[)(?<label>[^\\]\\r\\n]+) v[0-9]+\\.[0-9]+\\.[0-9]+\\]\\((?<url>https://github\\.com/Living-Proof-Labs/collaboration-guidelines/blob/)(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?<suffix>/[^)\\r\\n]+\\))"],
      "depNameTemplate": "Living-Proof-Labs/collaboration-guidelines",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{replace \" v[0-9]+[.][0-9]+[.][0-9]+\\][\\s\\S]*$\" \"\" replaceString}}} {{{newValue}}}](https://github.com/Living-Proof-Labs/collaboration-guidelines/blob/{{{newValue}}}{{{replace \"^[\\s\\S]*?\\]\\(https://github[.]com/Living-Proof-Labs/collaboration-guidelines/blob/v[0-9]+[.][0-9]+[.][0-9]+\" \"\" replaceString}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": ["# renovate: guidelines\\r?\\n[ \\t]+GUIDELINES_VERSION: '(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)'"],
      "depNameTemplate": "Living-Proof-Labs/collaboration-guidelines",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
